{
  "name": "write",
  "private": true,
  "version": "0.0.0",
  "description": "A minimal, private, local-only web journal with rich text, bundled fonts and markdown/JSON export.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "vite build && vite preview",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/bungee-hairline": "^5.3.0",
    "@fontsource/bungee-outline": "^5.3.0",
    "@fontsource/bungee-shade": "^5.3.0",
    "@fontsource/comforter": "^5.3.0",
    "@fontsource/dongle": "^5.3.0",
    "@fontsource/major-mono-display": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@fontsource/windsong": "^5.3.0",
    "@tiptap/extension-document": "^3.32.3",
    "@tiptap/extension-heading": "^3.32.3",
    "@tiptap/extension-paragraph": "^3.32.3",
    "@tiptap/extension-placeholder": "^3.32.3",
    "@tiptap/extension-strike": "^3.32.3",
    "@tiptap/extension-text-style": "^3.32.3",
    "@tiptap/markdown": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "culori": "^4.0.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
